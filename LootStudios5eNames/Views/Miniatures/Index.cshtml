@model IEnumerable<LootStudios5eNames.Models.Miniature>

@{
    ViewData["Title"] = "Test";
    int totalPages = ViewData["TotalPages"] as int? ?? 1;
    //int totalPages = 7;
    int currentPage = ViewData["CurrentPage"] as int? ?? 1;
    bool isFiltered = string.IsNullOrEmpty(ViewData["CurrentFilter"] as string);
}

<form asp-action="Index" method="get" class="filterInput">
    <input type="search" placeholder="Cultist" aria-label="Filter" name="filter" value="@ViewData["CurrentFilter"]"/>
    <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
    <button type="submit" class="btn btn-primary btn-primary-override">Search</button>

</form>

@if (!isFiltered)
{
    <form asp-action="Index" method="get" class="resetInput">
    <button type="submit" class="btn btn-info">Reset</button>
    </form>
}


<table class="table headerTable">
    <thead>
        <tr>
            <th>
               <a asp-action="Index" asp-route-sortOrder="@ViewData["LS_PackSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
                LS Pack @if(ViewData["CurrentSort"].ToString() == "LS_Pack")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-LS_Pack")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["LS_NameSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
                LS Name @if(ViewData["CurrentSort"].ToString() == "LS_Name")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-LS_Name")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                 </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["RoleSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
                Role @if(ViewData["CurrentSort"].ToString() == "Role")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-Role")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                 </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["RaceSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
                Race @if(ViewData["CurrentSort"].ToString() == "Race")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-Race")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                 </a>
            </th>
            <th>
                 <a asp-action="Index" asp-route-sortOrder="@ViewData["ClassSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
                Class @if(ViewData["CurrentSort"].ToString() == "Class")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-Class")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                 </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["SizeSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
                LS Size @if(ViewData["CurrentSort"].ToString() == "Size")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-Size")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                 </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LS_Image)
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["5e_NameSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
                5e Name @if(ViewData["CurrentSort"].ToString() == "5e_Name")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-5e_Name")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                 </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["5e_TypeSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
                5e Type @if(ViewData["CurrentSort"].ToString() == "5e_Type")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-5e_Type")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                 </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["5e_SizeSortParam"]" asp-route-filter="@ViewData["CurrentFilter"]">
               5e Size @if(ViewData["CurrentSort"].ToString() == "5e_Size")
                {
                        <span class="sortArrow">&#x25B2;</span>
                    } else if (ViewData["CurrentSort"].ToString() == "-5e_Size")
                    {
                        <span class="sortArrow">&#x25BC;</span>
                    }
                 </a>
            </th>
        </tr>
    </thead>
    </table>
    <table class="table">
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LS_Pack)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LS_Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LS_Role)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LS_Race)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LS_Class)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LS_Size)
            </td>
            <td>
                <div style="width: 100px; height: 100px; overflow: hidden;">
                    <img src="@item.LS_Image" alt="@item.LS_Name" width="100" height="100" />
                    </div>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item._5e_Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item._5e_Type)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item._5e_Size)
            </td>

        </tr>
}
    </tbody>
</table>

<div class="pagination">
    @if (Model.Any())
    {
        int displayRange = 8; // Set the number of pages to display around the current page
        <ul class="pagination">

            <li class="page-item @(currentPage == 1 ? "disabled": "")">
                <a class="page-link page-link-override" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                    Previous
                </a>
            </li>
            @if (totalPages <= 9)
            {
                for (var i = 1; i <= totalPages; i++)
                {
                    <li class="page-item  @(i == currentPage ? "active" : "")">
                        <a class="page-link page-link-override" asp-action="Index" asp-route-page="@i" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                            @i
                        </a>
                    </li>
                }
            }
            else if (currentPage < 7)
            {
                for (var i = 1; i <= 9; i++)
                {
                    <li class="page-item  @(i == currentPage ? "active" : "")">
                        <a class="page-link page-link-override" asp-action="Index" asp-route-page="@i" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                            @i
                        </a>
                    </li>
                }
                <li class="page-item">
                    <a class="page-link page-link-override disabled">...</a>
                </li>
                <li class="page-item">
                    <a class="page-link page-link-override" asp-action="Index" asp-route-page="@totalPages" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                        @totalPages
                    </a>
                </li>
            }
            else if (currentPage > totalPages - 5)
            {
                <li class="page-item">
                    <a class="page-link page-link-override" asp-action="Index" asp-route-page="1" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                        1
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link page-link-override disabled">...</a>
                </li>
                @for (var i = totalPages - 9; i <= totalPages; i++)
                {
                    <li class="page-item  @(i == currentPage ? "active" : "")">
                        <a class="page-link page-link-override" asp-action="Index" asp-route-page="@i" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                            @i
                        </a>
                    </li>
                }
            }
            else
            {
                <li class="page-item">
                    <a class="page-link page-link-override" asp-action="Index" asp-route-page="1" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                        1
                    </a>
                </li>
                <li class="page-item">
                    <a class="page-link page-link-override disabled">...</a>
                </li>
                @for (var i = Math.Max(1, currentPage - displayRange / 2); i <= Math.Min(totalPages, currentPage + displayRange / 2); i++)
                {
                    <li class="page-item  @(i == currentPage ? "active" : "")">
                        <a class="page-link page-link-override" asp-action="Index" asp-route-page="@i" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                            @i
                        </a>
                    </li>
                }
                <li class="page-item">
                    <a class="page-link page-link-override disabled">...</a>
                </li>
                <li class="page-item">
                    <a class="page-link page-link-override" asp-action="Index" asp-route-page="@totalPages" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                        @totalPages
                    </a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled": "")">
                <a class="page-link page-link-override" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="10" asp-route-sortOrder="@ViewData["CurrentSort"]" asp-route-filter="@ViewData["CurrentFilter"]">
                    Next
                </a>
            </li>

        </ul>
    }
</div>